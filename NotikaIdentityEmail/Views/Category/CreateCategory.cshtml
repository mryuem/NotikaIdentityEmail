@model Category
@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/UserLayout/Index.cshtml";
}
<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Yeni Kategori Ekleme </h2>
                    </div>
                    <div class="row">

                       <form  method="post">
                           <label>Kategori Adı</label>
                           <input type="text" asp-for="CategoryName" class="form-control" />
                           <br />
                           <label>Kategori Ikon Url</label>
                           <input type="text" asp-for="CategoryIcon" class="form-control" />
                           <br />
							<button type="submit" class="btn btn-primary">Kategoriyi Oluştur</button>
                       </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




