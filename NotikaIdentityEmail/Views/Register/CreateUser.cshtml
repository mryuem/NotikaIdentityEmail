@using NotikaIdentityEmail.Models.IdentityModels
@model RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Kullanıcı Kaydı</title>

    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <link rel="stylesheet"
          href="/login-form-18/css/style.css">

    <style>

        .login-form .form-group {
            margin-bottom: 15px;
        }

        .login-form input {
            height: 50px;
        }

        .register-button {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 5px;
            background-color: #28a745;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

            .register-button:hover {
                background-color: #218838;
            }

        .links-area {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 10px;
            margin-bottom: 20px;
        }

            .links-area a {
                text-decoration: none;
            }

        .validation-message {
            margin-bottom: 15px;
        }

    </style>

</head>


<body>

    <section class="ftco-section">

        <div class="container">

            <!-- BAŞLIK -->
            <div class="row justify-content-center">

                <div class="col-md-6 text-center mb-5">

                    <h2 class="heading-section">
                        Kullanıcı Kaydı
                    </h2>

                </div>

            </div>


            <!-- KAYIT KUTUSU -->
            <div class="row justify-content-center">

                <div class="col-md-7 col-lg-6">

                    <div class="login-wrap p-4 p-md-5">


                        <!-- İKON -->
                        <div class="icon d-flex align-items-center justify-content-center">

                            <span class="fa fa-user-plus"></span>

                        </div>


                        <h3 class="text-center mb-4">
                            Kayıt Ol
                        </h3>


                        <!-- KAYIT FORMU -->
                        <form method="post"
                              asp-controller="Register"
                              asp-action="CreateUser"
                              class="login-form">


                            <!-- AD -->
                            <div class="form-group">

                                <input type="text"
                                       class="form-control"
                                       placeholder="Adınız"
                                       asp-for="Name">

                            </div>


                            <!-- SOYAD -->
                            <div class="form-group">

                                <input type="text"
                                       class="form-control"
                                       placeholder="Soyadınız"
                                       asp-for="Surname">

                            </div>


                            <!-- KULLANICI ADI -->
                            <div class="form-group">

                                <input type="text"
                                       class="form-control"
                                       placeholder="Kullanıcı Adı"
                                       asp-for="Username">

                            </div>


                            <!-- E-POSTA -->
                            <div class="form-group">

                                <input type="email"
                                       class="form-control"
                                       placeholder="E-posta Adresi"
                                       asp-for="Email">

                            </div>


                            <!-- ŞİFRE -->
                            <div class="form-group">

                                <input type="password"
                                       class="form-control"
                                       placeholder="Şifre"
                                       asp-for="Password">

                            </div>


                            <!-- ŞİFRE TEKRARI -->
                            <div class="form-group">

                                <input type="password"
                                       class="form-control"
                                       placeholder="Şifre Tekrarı"
                                       asp-for="ConfirmPassword">

                            </div>


                            <!-- GİRİŞ LİNKİ -->
                            <div class="links-area">

                                <div>
                                    Zaten hesabın var mı?
                                    <a href="/Login/UserLogin">
                                        Giriş Yap
                                    </a>
                                </div>

                            </div>


                            <!-- HATA MESAJI -->
                            <div class="text-danger validation-message"
                                 asp-validation-summary="All">
                            </div>


                            <!-- KAYIT BUTONU -->
                            <div class="form-group">

                                <button type="submit"
                                        class="register-button">

                                    Kayıt Ol

                                </button>

                            </div>

                        </form>


                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- JAVASCRIPT -->

    <script src="/login-form-18/js/jquery.min.js"></script>

    <script src="/login-form-18/js/popper.js"></script>

    <script src="/login-form-18/js/bootstrap.min.js"></script>

    <script src="/login-form-18/js/main.js"></script>

</body>

</html>