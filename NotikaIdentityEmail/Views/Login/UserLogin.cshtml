
@using NotikaIdentityEmail.Models.IdentityModels
@model UserLoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Kullanıcı Girişi</title>

    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <link rel="stylesheet"
          href="/login-form-18/css/style.css">

    <style>

        .login-form .form-group {
            margin-bottom: 15px;
        }

        .login-form input {
            height: 50px;
        }

        .login-button {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 5px;
            background-color: #007bff;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

            .login-button:hover {
                background-color: #0069d9;
            }

        .google-area {
            margin-top: 20px;
            width: 100%;
        }

        .or-text {
            text-align: center;
            margin-bottom: 15px;
            color: #777;
            font-size: 14px;
        }

        .google-button {
            width: 100%;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: white;
            color: #333;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
        }

            .google-button:hover {
                background-color: #f5f5f5;
            }

        .google-icon {
            color: #DB4437;
            font-size: 20px;
            margin-right: 10px;
        }

        .links-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
            margin-bottom: 20px;
        }

            .links-area a {
                text-decoration: none;
            }

        .validation-message {
            margin-bottom: 15px;
        }

    </style>

</head>


<body>

    <section class="ftco-section">

        <div class="container">

            <!-- BAŞLIK -->
            <div class="row justify-content-center">

                <div class="col-md-6 text-center mb-5">

                    <h2 class="heading-section">
                        Kullanıcı Girişi
                    </h2>

                </div>

            </div>


            <!-- LOGIN KUTUSU -->
            <div class="row justify-content-center">

                <div class="col-md-6 col-lg-5">

                    <div class="login-wrap p-4 p-md-5">


                        <!-- İKON -->
                        <div class="icon d-flex align-items-center justify-content-center">

                            <span class="fa fa-user-o"></span>

                        </div>


                        <h3 class="text-center mb-4">
                            Giriş Yap
                        </h3>


                        <!-- NORMAL LOGIN -->
                        <form method="post"
                              asp-controller="Login"
                              asp-action="UserLogin"
                              class="login-form">


                            <!-- KULLANICI ADI -->
                            <div class="form-group">

                                <input type="text"
                                       class="form-control"
                                       placeholder="Kullanıcı Adı"
                                       asp-for="Username">

                            </div>


                            <!-- ŞİFRE -->
                            <div class="form-group">

                                <input type="password"
                                       class="form-control"
                                       placeholder="Şifre"
                                       asp-for="Password">

                            </div>


                            <!-- KAYIT / ŞİFRE -->
                            <div class="links-area">

                                <div>

                                    <a href="/Register/CreateUser/">
                                        Kayıt Ol
                                    </a>

                                </div>

                                <div>

                                    <a href="/PassWordChange/ForgetPassword">
                                        Şifreni mi unuttun?
                                    </a>

                                </div>

                            </div>


                            <!-- HATA MESAJI -->
                            <div class="text-danger validation-message"
                                 asp-validation-summary="All">
                            </div>


                            <!-- GİRİŞ BUTONU -->
                            <div class="form-group">

                                <button type="submit"
                                        class="login-button">

                                    Giriş Yap

                                </button>

                            </div>

                        </form>


                        <!-- GOOGLE LOGIN -->
                        <div class="google-area">

                            <div class="or-text">
                                veya
                            </div>


                            <!--
                                BURASI ÖNEMLİ

                                ExternalLogin action'ı POST olduğu için
                                Google butonunu form olarak gönderiyoruz.
                            -->

                            <form asp-controller="Login"
                                  asp-action="ExternalLogin"
                                  method="post">


                                <!-- Google Provider -->
                                <input type="hidden"
                                       name="provider"
                                       value="Google" />


                                <!-- Google Butonu -->
                                <button type="submit"
                                        class="google-button">

                                    <i class="fa fa-google google-icon"></i>

                                    Google ile Giriş Yap

                                </button>

                            </form>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- JAVASCRIPT -->

    <script src="/login-form-18/js/jquery.min.js"></script>

    <script src="/login-form-18/js/popper.js"></script>

    <script src="/login-form-18/js/bootstrap.min.js"></script>

    <script src="/login-form-18/js/main.js"></script>

</body>

</html>

